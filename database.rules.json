{
  "rules": {
    ".read": false,
    ".write": false,

    "fases": {
      "$fase": {
        "$sessao": {
          "status": {
            ".read": true,
            ".write": true,
            ".validate": "newData.isString() && (newData.val() === 'aberta' || newData.val() === 'encerrada')"
          },

          "participantes": {
            ".read": true,
            "$uid": {
              ".write": "auth.uid === $uid && root.child('fases').child($fase).child($sessao).child('status').val() === 'aberta'"
            }
          },

          "respostas": {
            ".read": true,
            "$pergunta": {
              "$uid": {
                ".write": "auth.uid === $uid && root.child('fases').child($fase).child($sessao).child('status').val() === 'aberta'",
                ".validate": "newData.hasChildren(['valor', 'em']) && (newData.child('valor').isString() === false || newData.child('valor').val().length <= 1000)"
              }
            }
          }
        }
      }
    }
  }
}
